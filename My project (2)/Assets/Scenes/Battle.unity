--- !u!114 &592987483
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 592987481}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2f0ae3025c22b749a236f2726899f46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CutsceneRoot: {fileID: 1970601239}
  CGScreen: {fileID: 304309982}
  DialogueText: {fileID: 1238568210}
  ContinueHint: {fileID: 261831740}
  SkipButton: {fileID: 796461368}
  FadeOverlay: {fileID: 217669360}
  Steps:
  - Type: 0
    Text: "\u201C\u7830\uFF01\uFF01\uFF01\uFF01\uFF01\uFF01\u201D"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u968F\u7740\u6700\u540E\u4E00\u4E2A\u654C\u4EBA\u7684\u8EAB\u5F71\u6D88\u6563\u4E8E\u7A7A\u6C14\u4E2D\uFF0C\r\n\u4F0A\u745E\u5C14\u9893\u9761\u5730\u7528\u6CD5\u6756\u652F\u6491\u7740\u8EAB\u5F62\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u795E\u660E\u51C6\u5907\u7684\u5355\u4EBA\u8BD5\u70BC\uFF0C\u4ECE\u53E4\u81F3\u4ECA\u4ECE\u672A\u6709\u4EBA\u5B8C\u6210\u8FC7\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u4F46\u5979\u505A\u5230\u4E86\u3002\u5979\u6CA1\u6709\u8F9C\u8D1F\u5927\u5BB6\u7684\u4FE1\u4EFB\u3002\r\n\u5979\u4E0D\u8FB1\u201C\u5929\u624D\u201D\u4E4B\u540D\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u5F53\u795E\u660E\u7684\u8003\u9A8C\u843D\u4E0B\u5E37\u5E55\uFF0C\u4E16\u754C\u7684\u707E\u7978\u5C06\u88AB\u6539\u5199\uFF0C\n\u5979\u80CC\u540E\u7684\u4E07\u5BB6\u706F\u706B\u5C06\u518D\u5EA6\u70B9\u71C3\u2014\u2014"
    CG: {fileID: 0}
  - Type: 1
    Text: 
    CG: {fileID: 21300000, guid: 7f86097b4c83d484da8c0e3f8104887b, type: 3}
  - Type: 0
    Text: "\u201C\u54BB\u2014\u2014\u201D"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u6495\u88C2\u5929\u7A7A\u7684\u7D2B\u8272\u5149\u8292\u6620\u5165\u773C\u5E18\uFF0C\u7206\u70B8\u58F0\u5728\u8EAB\u540E\u4F20\u6765\uFF0C\n\u9707\u5F97\u5979\u6709\u4E9B\u8033\u9E23\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u4F0A\u745E\u5C14\u5B8C\u5168\u662F\u9760\u5BF9\u5371\u673A\u7684\u672C\u80FD\u53CD\u5E94\u505A\u51FA\u7684\u95EA\u8EB2\u3002\n\u5979\u4E0D\u6562\u60F3\u8C61\u6CA1\u8EB2\u8FC7\u53BB\u7684\u540E\u679C\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u4F0A\u745E\u5C14\u5B8C\u5168\u662F\u9760\u5BF9\u5371\u673A\u7684\u672C\u80FD\u53CD\u5E94\u505A\u51FA\u7684\u95EA\u8EB2\u3002\n\u5979\u4E0D\u6562\u60F3\u8C61\u6CA1\u8EB2\u8FC7\u53BB\u7684\u540E\u679C\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u5929\u7A7A\u53D8\u4E86\u6837\u3002\u98D8\u6D6E\u5728\u5929\u7A7A\u4E2D\u7684\u751F\u7075\uFF0C\u773C\u4E2D\u6CA1\u6709\u4EFB\u4F55\u611F\u60C5\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u7942\u964D\u4E34\u4E86\u3002"
    CG: {fileID: 0}
  - Type: 1
    Text: 
    CG: {fileID: 21300000, guid: 2521561d2c9a8f1438f894da248cb74a, type: 3}
  - Type: 0
    Text: "\u201C\u5FEB\u8DD1\uFF01\uFF01\uFF01\uFF01\uFF01\u201D "
    CG: {fileID: 0}
  - Type: 0
    Text: "\u5FC3\u4E2D\u6572\u54CD\u4E86\u8B66\u949F\u3002\u7EDD\u65E0\u53EF\u80FD\u76F4\u9762\u7684\u5BF9\u624B\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u4F46\u662F\u5979\u52A8\u4E0D\u4E86\u4E86\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u7EC8\u7A76\u662F\u4E00\u573A\u7A7A\u5417\u2026\u2026\u201D"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u8FD9\u79CD\u7A0B\u5EA6\u679C\u7136\u65E0\u6CD5\u4F7F\u795E\u660E\u6EE1\u610F\u554A\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u4F46\u51FA\u4E4E\u610F\u6599\u7684\uFF0C\u6709\u58F0\u97F3\u5728\u8111\u4E2D\u56DE\u8361\uFF1A"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u4E0D\u9519\u554A\u3002\u5C45\u7136\u80FD\u505A\u5230\u8FD9\u79CD\u5730\u6B65\u5417\u3002\n\u6211\u5927\u6982\u8FD9\u8F88\u5B50\u90FD\u5FD8\u4E0D\u4E86\u4F60\u5427\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u65E2\u7136\u5982\u6B64\uFF0C\u7ED9\u4F60\u4E9B\u5956\u52B1\u5427\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u6211\u5C06\u6211\u7684\u795E\u529B\u7ED9\u4E88\u4F60\u3002\u201D"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u4F60\u4EE4\u6211\u5370\u8C61\u6DF1\u523B\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u4E0D\u8BBA\u5982\u4F55\uFF0C\u63A5\u4E0B\u6765\u6211\u4E0D\u4F1A\u518D\u5BF9\u2018\u73B0\u5B9E\u4E16\u754C\u2019\r\n\u8FDB\u884C\u4EFB\u4F55\u5E72\u9884\u4E86\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u4F60\u53EF\u4EE5\u7528\u6211\u7684\u795E\u529B\u505A\u4EFB\u4F55\u4E8B\uFF0C"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u5F53\u7136\uFF0C\u524D\u63D0\u662F\u4F60\u8FD8\u80FD\u6D3B\u7740\u3002\u201D"
    CG: {fileID: 0}
  - Type: 2
    Text: 
    CG: {fileID: 0}
  - Type: 0
    Text: "\u7942\u6D88\u5931\u4E86\uFF0C\u540C\u90A3\u906E\u5929\u853D\u65E5\u7684\u7D2B\u8272\u5149\u8292\u4E00\u540C\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u4F46\u91D1\u8272\u7684\u795E\u529B\u6B63\u6709\u610F\u8BC6\u822C\u7684\u6E38\u5411\u4F0A\u745E\u5C14\u7684\u4F53\u5185\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\uFF01\uFF01\uFF01\uFF01\uFF01\uFF01\uFF01\u201D"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u5F3A\u70C8\u7684\u4E0D\u9002\u611F\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u5F3A\u70C8\u7684\u6655\u7729\u611F\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u5F3A\u70C8\u7684\u75BC\u75DB\u3002"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u5979\u7684\u53CC\u773C\uFF0C\u76EE\u9001\u7740\u5979\u7684\u8089\u4F53\uFF0C\u5206\u5D29\u79BB\u6790\u3002 "
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u5FEB\uFF01\uFF01\u540E\u624B\u51C6\u5907\uFF01\uFF01\u201D"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u5728\u4F0A\u745E\u5C14\u5408\u4E0A\u53CC\u7738\u524D\uFF0C\u5979\u770B\u89C1\u98DE\u5954\u800C\u6765\u7684\u6CD5\u5E08\u4EEC\u3002\n\u65E0\u6570\u7B26\u6587\u5728\u8EAB\u4E0A\u663E\u73B0\u2014\u2014"
    CG: {fileID: 0}
  - Type: 1
    Text: 
    CG: {fileID: 21300000, guid: 79f6216aa586a8d448e5339916db8587, type: 3}
  - Type: 0
    Text: "\u201C\u5982\u679C\u4F0A\u745E\u5C14\u906D\u9047\u610F\u5916\uFF0C\u6211\u4EEC\u9700\u8981\u7B2C\u4E00\u65F6\u95F4\u5265\u79BB\u5979\u7684\u610F\u8BC6\uFF0C\n\u5C06\u5979\u9001\u5230\u610F\u8BC6\u4E16\u754C\u53BB\u3002\u201D"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u8FD9\u662F\u6CA1\u6709\u529E\u6CD5\u7684\u529E\u6CD5\uFF0C\u53E4\u5F80\u4ECA\u6765\u8FDB\u5165\u610F\u8BC6\u4E16\u754C\u7684\u4EBA\u5BE5\u5BE5\u65E0\u51E0\uFF0C             
      \u6211\u4EEC\u5BF9\u90A3\u91CC\u6240\u77E5\u751A\u5C11\u3002\u201D"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u4F46\u90A3\u91CC\u662F\u552F\u4E00\u80FD\u5728\u8089\u4F53\u6B7B\u4EA1\u7684\u60C5\u51B5\u4E0B\u4FDD\u7559\u795E\u5FD7\u7684\u5730\u65B9\u3002\u201D"
    CG: {fileID: 0}
  - Type: 0
    Text: "\u201C\u6211\u4EEC\u7EDD\u4E0D\u80FD\u653E\u5F03\u4F0A\u745E\u5C14\uFF0C\u5979\u662F\u4E00\u5207\u7684\u5E0C\u671B\u3002\u201D"
    CG: {fileID: 0}
  - Type: 2
    Text: 
    CG: {fileID: 0}
  - Type: 0
    Text: "\u5728\u4F0A\u745E\u5C14\u7684\u8089\u4F53\u6B7B\u4EA1\u4E4B\u9645\uFF0C\u65E0\u4E3B\u7684\u795E\u529B\u6EE1\u6EA2\u800C\u51FA\uFF0C\r\n\u56DB\u6563\u6D8C\u5165\u5927\u5730\u3002\r"
    CG: {fileID: 0}
  - Type: 0
